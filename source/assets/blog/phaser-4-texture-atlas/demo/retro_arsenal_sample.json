  "pivot_normalised": "frames[].pivot - origin bottom-left, 0..1 (x,y), Unity convention",
  "pivot_px_top_left": "custom.pivot_px - same point, top-left pixel origin",
  "muzzle_px": "custom.muzzle_px, top-left pixel origin, meaning depends on custom.weapon_type: 'gun' = projectile spawn point; 'blade' = blade tip / hit-effect point; 'grenade' = pin-ring / release point. Identical across a weapon's 3 tiers.",
  "suggested_pixels_per_unit": 256,
  "naming": "weapon_laser_<type>_<tier>.png, e.g. weapon_laser_rifle_t2_military.png",
  "background": "transparent, straight alpha, no baked shadow/glow",
  "tiers": "t1_scrap (salvaged), t2_military (issued), t3_prototype (experimental) - same silhouette per weapon across all 3 tiers"
 }
